# Security: allowed hosts (TrustedHostMiddleware)
# Use exact hosts and/or wildcards supported by Starlette, comma-separated.
TRUSTED_HOSTS=
# Security: allowed browser origins (CORS)
# Include your production frontend and local dev Vite origin.
ALLOWED_ORIGINS=
# Public base URL used to build absolute /memes URLs in responses
# If unset, responses use relative URLs like /memes/filename.png
PUBLIC_BASE_URL=
# Rate limiting (per-IP sliding window)
RATE_LIMIT_WINDOW_SECONDS=RATE_LIMIT_MAX_REQUESTS=# Optionally skip specific paths from rate limiting
RATE_LIMIT_EXCLUDE_PATHS=
# Upload/payload size guard
MAX_UPLOAD_MB=
# Paths where size limit should apply
SIZE_LIMIT_PATH=